<Window x:Class="Anuxes.LogLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Anuxes.LogLens"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ANUXES LOGLENS"
        Width="1380" Height="850" MinWidth="1040" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" CornerRadius="10"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Margin="7" Background="{StaticResource BackgroundBrush}"
            BorderBrush="#59417D" BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#9B70FF" BlurRadius="20" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="48" />
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Custom title bar / window controls -->
            <Border Grid.Row="0" Background="#151319" CornerRadius="9,9,0,0"
                    BorderBrush="#30273D" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="25" Height="25" CornerRadius="7" Background="#282035"
                            BorderBrush="#7856A8" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="A" Foreground="#D5C2FF" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="ANUXES" FontWeight="SemiBold" FontSize="13" Foreground="#E7E3EF" />
                        <TextBlock Text="  LOGLENS" FontWeight="SemiBold" FontSize="13" Foreground="#B99AFF" />
                        <TextBlock Text="  v0.2.1" FontSize="10" Foreground="#85808F" VerticalAlignment="Center" Margin="5,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#55D69A" Margin="0,0,7,0" />
                        <TextBlock Text="LOCAL FILE MODE" FontSize="9" Foreground="#A8A2B2" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Text="ANUXES DIVISION  •  Kas1mov" FontSize="9" Foreground="#827A90" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Style="{StaticResource ChromeButton}" Content="—" ToolTip="Minimize"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="□" ToolTip="Maximize / Restore"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeRestore_Click" />
                        <Button Style="{StaticResource ChromeCloseButton}" Content="×" ToolTip="Close"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toolbar -->
            <Border Grid.Row="1" Background="#17151B" BorderBrush="#292530" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="＋  Open Log" Style="{StaticResource AccentButton}"
                            Click="OpenFile_Click" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Background="#101014" BorderBrush="#3B3448" BorderThickness="1"
                            CornerRadius="7" Margin="0,7,8,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="25" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="19" Foreground="#A89ABF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged"
                                     BorderThickness="0" Background="Transparent" Padding="2,7"
                                     VerticalContentAlignment="Center" ToolTip="Search all log entries (case-insensitive)" />
                            <TextBlock Grid.Column="2" Text="/" Foreground="#777080" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SearchMatchCount" Grid.Column="3" Text="0 / 0" Foreground="#A99CB9"
                               FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Button Grid.Column="4" Style="{StaticResource QuietGlowButton}" Content="‹" ToolTip="Previous match"
                            Click="PreviousMatch_Click" Margin="0,0,3,0" Padding="9,5" />
                    <Button Grid.Column="5" Style="{StaticResource QuietGlowButton}" Content="›" ToolTip="Next match"
                            Click="NextMatch_Click" Margin="0,0,9,0" Padding="9,5" />
                    <CheckBox x:Name="LiveModeCheck" Grid.Column="6" Content="Live Mode" VerticalAlignment="Center"
                              Margin="0,0,10,0" IsChecked="False" Checked="LiveMode_Changed" Unchecked="LiveMode_Changed" />
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↻  Refresh" Click="Refresh_Click" Margin="0,0,6,0" />
                        <Button x:Name="PauseButton" Content="Ⅱ  Pause" Click="Pause_Click" Margin="0,0,6,0" />
                        <Button Content="⇩  Export" Style="{StaticResource AccentButton}" Click="ExportReport_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live severity summary -->
            <Border Grid.Row="2" Background="#121116" BorderBrush="#292530" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource MetricPill}" BorderBrush="#68363B" Margin="0,7,8,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#F87171" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="ERROR" Foreground="#F7A0A0" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ErrorCount" Text="0" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricPill}" BorderBrush="#66502A" Margin="0,7,8,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#FBBF24" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="WARN" Foreground="#F6D17A" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="WarnCount" Text="0" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricPill}" BorderBrush="#673B51" Margin="0,7,8,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#FB7185" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="FATAL" Foreground="#F9A1B2" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="FatalCount" Text="0" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="4" Text="SEVERITY OVERVIEW" Foreground="#746D7D" FontSize="9"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Main workspace -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218" MinWidth="190" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" MinWidth="350" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="285" MinWidth="230" />
                </Grid.ColumnDefinitions>

                <!-- Filters sidebar -->
                <Border Grid.Column="0" Background="#141316" BorderBrush="#292530" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,16,14,18">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="⌄" Foreground="#B69AD8" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="FILTERS" Foreground="#D0CDD6" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="LEVEL" Foreground="#8E8798" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <CheckBox x:Name="TraceFilter" Content="TRACE" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" />
                            <CheckBox x:Name="DebugFilter" Content="DEBUG" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" />
                            <CheckBox x:Name="InfoFilter" Content="INFO" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" />
                            <CheckBox x:Name="WarnFilter" Content="WARN" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" />
                            <CheckBox x:Name="ErrorFilter" Content="ERROR" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" />
                            <CheckBox x:Name="FatalFilter" Content="FATAL" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" />
                            <CheckBox x:Name="OtherFilter" Content="OTHER / UNPARSED" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" />

                            <Border Height="1" Background="#302A38" Margin="0,13,0,13" />
                            <TextBlock Text="SOURCE" Foreground="#8E8798" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock x:Name="SourceName" Text="No file selected" Foreground="#B7B2C0" FontSize="11" TextWrapping="Wrap" />

                            <Border Height="1" Background="#302A38" Margin="0,13,0,13" />
                            <TextBlock Text="ABOUT" Foreground="#8E8798" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <TextBlock Text="ANUXES LOGLENS" Foreground="#D0CDD6" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="Log analysis system" Foreground="#8E8798" FontSize="10" Margin="0,3,0,0" />
                            <TextBlock Text="Published by ANUXES DIVISION" Foreground="#827A90" FontSize="10" Margin="0,9,0,0" />
                            <TextBlock Text="Developed by Kas1mov" Foreground="#B99AFF" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#25212C" />

                <!-- Log table -->
                <Grid Grid.Column="2" Background="#111013">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#111013" BorderBrush="#302A38" BorderThickness="0,0,0,1">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TIME" Foreground="#8E8798" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="LEVEL" Foreground="#8E8798" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="MESSAGE" Foreground="#8E8798" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="LogGrid" ItemsSource="{Binding LogView}"
                              AutoGenerateColumns="False" CanUserSortColumns="True"
                              SelectionChanged="LogGrid_SelectionChanged" HeadersVisibility="None"
                              RowHeaderWidth="0" IsTabStop="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding TimeText}" Width="150" />
                            <DataGridTextColumn Binding="{Binding Level}" Width="82">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="#F87171" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="FATAL"><Setter Property="Foreground" Value="#FB7185" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Foreground" Value="#FBBF24" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="INFO"><Setter Property="Foreground" Value="#86EFAC" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="DEBUG"><Setter Property="Foreground" Value="#B99AFF" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="TRACE"><Setter Property="Foreground" Value="#67E8F9" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="OTHER"><Setter Property="Foreground" Value="#9CA3AF" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <local:HighlightTextBlock SourceText="{Binding Message}"
                                            SearchTerm="{Binding DataContext.SearchTerm, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            Foreground="#D7D3DE" FontFamily="Consolas" FontSize="11.5"
                                            VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Background="#111013" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="NO LOG LOADED" Foreground="#C2BBCD" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Open a .log or .txt file to begin analysis" Foreground="#827A90" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#25212C" />

                <!-- Inspector -->
                <Border Grid.Column="4" Background="#141316" BorderBrush="#302A38" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,16,15,18">
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="ENTRY INSPECTOR" Foreground="#D0CDD6" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="DETAILS" Foreground="#827A90" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="TIME" Foreground="#8E8798" FontSize="9" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedEntry.TimeText, TargetNullValue='—'}" Foreground="#D0CDD6" FontFamily="Consolas" FontSize="11" Margin="0,5,0,15" TextWrapping="Wrap" />
                            <TextBlock Text="LEVEL" Foreground="#8E8798" FontSize="9" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedEntry.Level, TargetNullValue='—'}" Foreground="#B99AFF" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,15" />
                            <TextBlock Text="MESSAGE" Foreground="#8E8798" FontSize="9" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedEntry.Message, TargetNullValue='Select a log entry'}" Foreground="#D0CDD6" FontSize="11" Margin="0,5,0,15" TextWrapping="Wrap" />
                            <Border Height="1" Background="#302A38" Margin="0,0,0,14" />
                            <TextBlock Text="RAW ENTRY" Foreground="#8E8798" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <TextBox Text="{Binding SelectedEntry.Raw, TargetNullValue='No entry selected'}" IsReadOnly="True"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     MinHeight="190" MaxHeight="420" Background="#101014" BorderBrush="#302A38"
                                     FontFamily="Consolas" FontSize="10" />
                            <TextBlock Text="Select a row to inspect its full content." Foreground="#827A90" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="4" Background="#151319" BorderBrush="#302A38" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterStatus" Text="Ready  •  Open a log file to start" Foreground="#968DA0" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock x:Name="FooterCount" Grid.Column="1" Text="0 / 0 ENTRIES" Foreground="#968DA0" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
